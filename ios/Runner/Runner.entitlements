<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications — change to "production" for App Store / TestFlight builds -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Required for firebase_messaging background notifications -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>

	<!-- Universal Links / Deep Links for scholarship portal redirects -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:usma-scholarship-mota.web.app</string>
		<string>applinks:usma-scholarship-mota.firebaseapp.com</string>
	</array>
</dict>
</plist>